---
import Base from '../layouts/Base.astro';
import Email from '../components/Email.astro';
---

<Base title="Thank you | Matka Ceramics">
  <section class="mk-page">
    <h1>Thank you</h1>

    <p>
      Your order is in. Stripe has emailed you a receipt, and you'll get a second
      email with a tracking number once the label is printed, usually within
      3 to 5 business days.
    </p>

    <p>
      Because every piece is one of a kind, yours is now marked sold on the site.
      Nobody else was going to get that one.
    </p>

    <p>
      Anything at all, <Email>email me</Email>. <a href="/">Back to the ceramics</a>.
    </p>
  </section>
</Base>

<script>
  // The order is placed; the cart has done its job.
  import { clear } from '../scripts/cart';
  clear();
</script>
