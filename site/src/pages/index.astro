---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base>
  {
    products.length === 0 ? (
      <p class="mk-empty">
        Nothing available right now. New pieces are announced on Instagram first.
      </p>
    ) : (
      <ul class="mk-grid">
        {products.map((p) => (
          <li class="mk-item" data-piece={p.id}>
            <a href={`/piece/${p.id}`}>
              <Image
                class={
                  p.data.image.width / p.data.image.height > 1
                    ? 'mk-shot wide'
                    : 'mk-shot'
                }
                src={p.data.image}
                alt={p.data.title}
                widths={[280, 560, 840]}
                sizes="(max-width: 460px) 100vw, (max-width: 820px) 50vw, (max-width: 1100px) 33vw, 25vw"
                loading={p.data.order <= 4 ? 'eager' : 'lazy'}
              />
              <span class="mk-name">{p.data.title}</span>
              <span class={p.data.soldOut ? 'mk-price out' : 'mk-price'}>
                {p.data.soldOut ? 'Sold out' : `$${p.data.price}`}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
