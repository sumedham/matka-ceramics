---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Tells Google what the grid is, rather than leaving it to infer a list of
// images. Prices and availability come straight from the same content files
// the shop is built from, so they cannot drift.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Ceramics by Matka Ceramics',
  url: 'https://www.matkaceramics.store/',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: products.length,
    itemListElement: products.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Product',
        name: p.data.title,
        url: `https://www.matkaceramics.store/piece/${p.id}/`,
        offers: {
          '@type': 'Offer',
          price: p.data.price,
          priceCurrency: 'USD',
          availability: p.data.soldOut
            ? 'https://schema.org/SoldOut'
            : 'https://schema.org/InStock',
        },
      },
    })),
  },
};
---

<Base schema={schema}>
  <h1 class="mk-sr">Handmade South Asian ceramics, thrown in Brooklyn</h1>
  {
    products.length === 0 ? (
      <p class="mk-empty">
        Nothing available right now. New pieces are announced on Instagram first.
      </p>
    ) : (
      <ul class="mk-grid">
        {products.map((p) => (
          <li class="mk-item" data-piece={p.id}>
            <a href={`/piece/${p.id}`}>
              <Image
                class={
                  p.data.image.width / p.data.image.height > 1
                    ? 'mk-shot wide'
                    : 'mk-shot'
                }
                src={p.data.image}
                alt={p.data.title}
                widths={[280, 560, 840]}
                sizes="(max-width: 460px) 100vw, (max-width: 820px) 50vw, (max-width: 1100px) 33vw, 25vw"
                loading={p.data.order <= 4 ? 'eager' : 'lazy'}
              />
              <span class="mk-name">{p.data.title}</span>
              <span class={p.data.soldOut ? 'mk-price out' : 'mk-price'}>
                {p.data.soldOut ? 'Sold out' : `$${p.data.price}`}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
