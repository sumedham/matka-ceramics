---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  /* Absolute or root-relative image for link previews. Falls back to the card. */
  image?: string;
  /* "website" for pages, "product" for a piece. */
  ogType?: string;
  /* Structured data for this page, serialised into a JSON-LD script. */
  schema?: Record<string, unknown>;
}

// Ids that can still be bought. The badge filters against these so it can never
// disagree with the cart page — a stale or sold id shouldn't be counted.
const availableIds = (await getCollection('products'))
  .filter((p) => !p.data.soldOut)
  .map((p) => p.id);

const {
  title = 'Matka Ceramics | Handmade South Asian ceramics from Brooklyn',
  description =
    'Handmade ceramics thrown in Brooklyn, inspired by South Asia. Chai khullads, matkas, ' +
    'vases and candles. Every piece is one of a kind. When it is gone, it is gone.',
  image = '/og.jpg',
  ogType = 'website',
  schema,
} = Astro.props;

const path = Astro.url.pathname;
const isShop = path === '/' || path.startsWith('/piece');

// Absolute URLs, because link previews and canonical tags both need them.
const canonical = new URL(path, Astro.site ?? 'https://www.matkaceramics.store');
const ogImage = new URL(image, Astro.site ?? 'https://www.matkaceramics.store');

/*
  Structured data. Without it Google treats the shop as an undifferentiated
  page; with it, pieces can appear with a price and availability attached.
*/
const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Matka Ceramics',
  url: 'https://www.matkaceramics.store',
  description,
  logo: new URL('/wordmark.png', Astro.site ?? 'https://www.matkaceramics.store').href,
  sameAs: ['https://www.instagram.com/matkaceramics/'],
  address: { '@type': 'PostalAddress', addressLocality: 'Brooklyn', addressRegion: 'NY', addressCountry: 'US' },
};

const jsonLd = schema ?? defaultSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <!-- Link previews. Without these, sharing the shop anywhere shows no
         picture at all, which for a shop made of photographs is the single
         most expensive thing to get wrong. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Matka Ceramics" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content="Handmade ceramics by Matka Ceramics" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
    />
  </head>

  <body>
    <div class="mk">
      <aside class="mk-side">
        <a class="mk-mark" href="/">
          <Wordmark />
          <em>ceramics</em>
        </a>

        <nav class="mk-nav">
          <a href="/" aria-current={isShop ? 'page' : undefined}>Ceramics</a>
          <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a>
          <!-- A section of About rather than its own page, so the menu grows by
               one word instead of the shop gaining another thing to maintain. -->
          <a href="/about#commissions">Commissions</a>
          <a class="cart" href="/cart">Cart (<span data-cart-count>0</span>)</a>
        </nav>
      </aside>

      <main class="mk-main">
        <slot />

        <footer class="mk-foot">
          <p class="nl">New pieces and studio sale dates, roughly monthly.</p>
          <div class="lk">
            <a href="https://www.instagram.com/matkaceramics/" rel="me">Instagram</a>
            <a href="/about">Contact</a>
          </div>
        </footer>
      </main>
    </div>

    <script define:vars={{ availableIds }}>
      window.__MATKA_AVAILABLE__ = availableIds;
    </script>

    <script>
      // The badge reads through the same module as everything else, so the
      // cart's shape is defined in exactly one place.
      import { read } from '../scripts/cart';

      const available = new Set<string>((window as any).__MATKA_AVAILABLE__ ?? []);

      const paint = () => {
        const n = String(read().filter((l) => available.has(l.id)).length);
        document.querySelectorAll('[data-cart-count]').forEach((el) => {
          el.textContent = n;
        });
      };

      paint();
      window.addEventListener('storage', paint); // another tab changed it
      document.addEventListener('matka:cart-changed', paint);

      /*
        Turn every obfuscated address into a real mailto link, keeping whatever
        label the span already carries. Lives here rather than in the component
        so it is emitted once per page instead of once per use.
      */
      document.querySelectorAll<HTMLElement>('.mk-email').forEach((el) => {
        const { user, domain } = el.dataset;
        if (!user || !domain) return;

        const address = `${user}@${domain}`;
        const link = document.createElement('a');
        link.href = `mailto:${address}`;
        link.textContent = (el.textContent || '').trim() || address;
        el.replaceWith(link);
      });

      /*
        These pages are static, so they are only as current as the last build.
        Correct them against pieces that have sold since.

        Cosmetic only — /api/checkout enforces the same list server-side, so if
        this fetch is blocked or stale nobody can still buy a sold piece.
      */
      (async () => {
        let sold: string[] = [];
        try {
          const res = await fetch('/api/sold');
          if (!res.ok) return;
          const data = await res.json();
          if (!Array.isArray(data?.sold) || data.sold.length === 0) return;
          sold = data.sold;
        } catch {
          return; // offline or blocked: leave the page as built
        }

        const soldSet = new Set(sold);

        document.querySelectorAll<HTMLElement>('[data-piece]').forEach((el) => {
          if (!soldSet.has(el.dataset.piece!)) return;
          const price = el.querySelector('.mk-price');
          if (price) {
            price.textContent = 'Sold out';
            price.classList.add('out');
          }
        });

        const addBtn = document.querySelector<HTMLButtonElement>('[data-add]');
        if (addBtn && soldSet.has(addBtn.dataset.add!)) {
          addBtn.disabled = true;
          addBtn.textContent = 'Sold out';
        }

        // Shrink the buyable list so the badge and the cart drop it too.
        const next = (available.size ? [...available] : []).filter((id) => !soldSet.has(id));
        available.clear();
        next.forEach((id) => available.add(id));
        (window as any).__MATKA_AVAILABLE__ = next;
        document.dispatchEvent(new CustomEvent('matka:cart-changed'));
      })();
    </script>
  </body>
</html>
