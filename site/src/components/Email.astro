---
/*
  Contact address, assembled in the browser so it isn't sitting in the HTML
  source for address harvesters to scrape.

  Pass a label as a child to show a word instead of the address:
      <Email>email me</Email>
  With no child it falls back to the readable "name [at] domain" form.

  The script that turns these into links lives once in Base.astro, not here —
  a component-level script gets re-emitted inline at every use, which dropped a
  <script> tag into the middle of a paragraph.
*/
interface Props {
  user?: string;
  domain?: string;
}

const { user = 'sumedha.mehta', domain = 'gmail.com' } = Astro.props;
const hasLabel = Astro.slots.has('default');
---

<span class="mk-email" data-user={user} data-domain={domain}>
  {hasLabel ? <slot /> : `${user} [at] ${domain}`}
</span>{
  /* Without JavaScript the label alone gives no way to reach her. */
  hasLabel && <noscript> ({user} [at] {domain})</noscript>
}
